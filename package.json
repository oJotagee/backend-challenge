{
  "name": "backend-challenge",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@mikro-orm/core": "^7.2.4",
    "@mikro-orm/decorators": "7.2.4",
    "@mikro-orm/migrations": "^7.2.4",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.4",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "app:up": "docker compose --profile app up -d --build",
    "migrate": "bun src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun src/infrastructure/database/migrate.ts down",
    "test": "bun test ./test/unit/*.spec.ts",
    "test:integration": "bun test ./test/integration/*.spec.ts --timeout 60000",
    "test:concurrency": "bun test ./test/concurrency/*.spec.ts --timeout 60000",
    "test:all": "bun test --timeout 60000",
    "migration:create": "bunx --bun mikro-orm migration:create",
    "migration:check": "bunx --bun mikro-orm migration:check",
    "app:down": "docker compose --profile app stop app",
    "test:load": "bun test/load/load-test.ts"
  }
}
