NODE_ENV=development
PORT=3000
LOG_LEVEL=info
INSTANCE_ID=local-1

# Database url
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
TEST_DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering_test

# AWS Config
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# SQS Config
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_WAIT_TIME_SECONDS=20
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=300

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=8

WORKERS_ENABLED=true
SHUTDOWN_GRACE_MS=10000
